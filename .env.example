# bill-snap local configuration.
# Copy to .env. The server and MCP process load .env from the working
# directory and do not override variables that are already set.
# Never commit .env or real API keys.

# Listen address. Default is 127.0.0.1:8080 (loopback only).
# Use :8080 to listen on all interfaces when a phone on the same LAN must connect.
HTTP_ADDR=127.0.0.1:8080

# Required by the HTTP server. Send as Authorization: Bearer <token>
# or as the X-API-Token header. The MCP stdio process does not use this.
UPLOAD_TOKEN=change-me

# SQLite file and screenshot directory. Both are created if missing.
DB_PATH=data/bills.db
UPLOAD_DIR=data/uploads

# Time zone used to interpret YYYY-MM-DD query bounds.
APP_TZ=Asia/Shanghai

# Largest accepted upload, in bytes. Default 8388608 (8 MiB).
MAX_UPLOAD_BYTES=8388608

# mock | qwen | doubao | glm
# mock is offline and deterministic. The others are thin OpenAI-compatible clients.
VISION_PROVIDER=mock
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
